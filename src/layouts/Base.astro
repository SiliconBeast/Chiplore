---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/doto';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { u, REPO } from '../lib/url.js';

interface Props {
  title?: string;
  description?: string;
  active?: 'Courses' | 'Roadmaps' | 'Practice' | 'Lab' | '';
  footer?: boolean;
  header?: boolean;
}
const {
  title,
  description = 'Free, open-source, hands-on lessons from a single logic gate to your own chip and the board it sits on. Everything runs in the browser.',
  active = '',
  footer = true,
  header = true,
} = Astro.props;
const fullTitle = title ? `${title} · Chiplore` : 'Chiplore · Learn how chips and circuit boards really work';
const nav = [
  ['Courses', '/courses/'],
  ['Roadmaps', '/roadmaps/'],
  ['Practice', '/practice/draw-the-waveform/'],
  ['Lab', '/lab/'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0D131C" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {header && (
      <header class="site-header">
        <div class="wrap">
          <a class="brand" href={u('/')} aria-label="Chiplore home">
            <Logo />
            <span class="wordmark">CHIPLORE</span>
          </a>
          <nav class="main-nav" aria-label="Main">
            {nav.map(([name, href]) => (
              <a href={u(href)} aria-current={active === name ? 'page' : undefined}>{name}</a>
            ))}
          </nav>
          <a class="header-gh" href={REPO}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6 3v12M6 15a3 3 0 1 0 0 6a3 3 0 1 0 0-6M18 3a3 3 0 1 0 0 6a3 3 0 1 0 0-6M18 9a9 9 0 0 1-9 9"></path></svg>
            <span>Open source</span>
          </a>
        </div>
      </header>
    )}
    <main id="main">
      <slot />
    </main>
    {footer && (
      <footer class="site-footer">
        <div class="wrap">
          <div style="max-width: 480px">
            <p style="margin: 0; font-weight: 600">Open source, written in the open</p>
            <p class="muted" style="margin: 8px 0 0; font-size: 15px; line-height: 1.6">Every lesson, exercise and lab is on GitHub. Spot a mistake? Send a pull request. Lessons are CC BY-SA 4.0, code is MIT.</p>
          </div>
          <div class="footer-links">
            <a href={`${REPO}/blob/main/CONTRIBUTING.md`}>Contribute</a>
            <a href={u('/about/')}>About and mastery</a>
            <a href={REPO}>GitHub</a>
          </div>
        </div>
      </footer>
    )}
    <script>
      import { paint } from '../scripts/progress.js';
      paint();
    </script>
  </body>
</html>
