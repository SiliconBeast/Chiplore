---
import Base from '../layouts/Base.astro';
import CourseArt from '../components/CourseArt.astro';
import Zoom from '../components/Zoom.astro';
import TraceField from '../components/TraceField.astro';
import Bench from '../components/Bench.astro';
import Bus from '../components/Bus.astro';
import { courses, roadmaps } from '../data/courses.js';
import { u } from '../lib/url.js';

const starts = [
  { title: 'Brand new to hardware', body: 'Start from bits and logic gates. No background needed.', href: '/learn/digital-logic/logic-gates/', icon: 'M3 9h5M3 15h5M8 5h5a7 7 0 0 1 0 14H8zM20 12h2' },
  { title: 'Coming from software', body: 'See how code you know maps onto real hardware.', href: '/learn/digital-logic/d-flip-flop/', icon: 'M5 5h14v14H5zM10 9.5L7.5 12l2.5 2.5M14 9.5l2.5 2.5-2.5 2.5' },
  { title: 'Aiming for a hardware job', body: 'Follow a role roadmap and practise real interview problems.', href: '/roadmaps/', icon: 'M4 19a2 2 0 1 0 4 0a2 2 0 1 0-4 0M16 5a2 2 0 1 0 4 0a2 2 0 1 0-4 0M8 19h6a3 3 0 0 0 0-6h-4a3 3 0 0 1 0-6h6' },
  { title: 'Teaching a class', body: 'Assign free lessons and labs, and fork them for your course.', href: 'https://github.com/SiliconBeast/Chiplore', icon: 'M3 5h6a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H3zM21 5h-6a3 3 0 0 0-3 3v12a2 2 0 0 1 2-2h7z' },
];
const units = (c: any) => (c.units ? `${c.units.length} units` : 'Being written');
---
<Base>
  <section class="hero-band">
  <TraceField seed={11} fade="left" />
  <div class="wrap hero">
    <div class="hero-text">
      <p class="kicker blink" data-scramble="intro" style="margin-bottom: 22px">Gate · Chip · Board</p>
      <h1 class="display">
        <span class="w" style="--i:0">Learn</span> <span class="w" style="--i:1">how</span> <span class="w" style="--i:2"><span class="pxw" data-scramble>chips</span></span> <span class="w" style="--i:3">and</span> <span class="w it hl" style="--i:4">circuit boards</span> <span class="w" style="--i:5">really</span> <span class="w" style="--i:6">work.</span>
      </h1>
      <p class="lead">Free, hands-on lessons from a <b>single logic gate</b> to <b>your own chip</b> and the board it sits on. Everything <b>runs in the browser</b>.</p>
      <div class="hero-ctas">
        <a class="btn go" href={u('/courses/digital-logic/')}>Start learning <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn" href={u('/roadmaps/')}>See roadmaps</a>
      </div>
      <p class="pixel quiet" style="margin: 24px 0 0; font-size: 15px">No account · open source · always free</p>
    </div>
    <div class="zoom-hold"><Zoom /></div>
  </div>
  </section>

  <section class="wrap block" aria-labelledby="start-title">
    <h2 id="start-title" class="h2"><span class="sec-num" aria-hidden="true"><b>01</b> / 04</span>Where are you <span class="it">starting</span> from?</h2>
    <div class="two-col">
      {starts.map((s) => (
        <a class="row-link" href={s.href.startsWith('http') ? s.href : u(s.href)}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#62D6A2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon}></path></svg>
          <span style="flex: 1 1 auto"><span style="display: block; font-size: 17px; font-weight: 600">{s.title}</span><span class="muted" style="display: block; margin-top: 2px; font-size: 15px">{s.body}</span></span>
          <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8A94A6" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
        </a>
      ))}
    </div>
  </section>

  <Bus />
  <section class="band" aria-labelledby="courses-title">
    <div class="wrap">
      <h2 id="courses-title" class="h2"><span class="sec-num" aria-hidden="true"><b>02</b> / 04</span>Courses, <span class="it">gate to board</span></h2>
      <p class="muted" style="margin: 8px 0 0; font-size: 17px">Start at the top and work down, or jump straight to what you need.</p>
      <div class="course-grid">
        {courses.map((c, i) => (
          <a class="course-card" href={u(`/courses/${c.slug}/`)}>
            <CourseArt name={c.art} vt={`art-${c.slug}`} />
            <span>
              <span class="idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="course-name" style={`view-transition-name: title-${c.slug}`}>{c.title}</span>
              <span class="muted course-blurb">{c.blurb}</span>
              <span class="quiet course-meta">{c.meta} · {units(c)}{c.status === 'writing' ? ' · help wanted' : ''}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Bus flip />
  <section class="band" aria-labelledby="how-title">
    <div class="wrap">
      <h2 id="how-title" class="h2"><span class="sec-num" aria-hidden="true"><b>03</b> / 04</span>Hardware you can <span class="it">poke</span></h2>
      <p class="muted" style="margin: 8px 0 0; font-size: 17px; max-width: 640px">Every lesson is built from things like these: <span class="hl">live circuits</span>, <span class="hl">skills drawn as eye diagrams</span>, and <span class="hl">projects that end in real silicon</span>. Go on, touch them.</p>
      <Bench />
    </div>
  </section>

  <Bus />
  <section class="band" aria-labelledby="roles-title">
    <div class="wrap">
      <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap">
        <h2 id="roles-title" class="h2"><span class="sec-num" aria-hidden="true"><b>04</b> / 04</span>Roadmaps to <span class="it hl">real jobs</span></h2>
        <a href={u('/roadmaps/')} style="font-weight: 600; font-size: 15px">All {roadmaps.length} roadmaps</a>
      </div>
      <div style="margin-top: 20px">
        {roadmaps.slice(0, 3).map((r) => (
          <a class="row-link" href={u(`/roadmaps/#${r.id}`)}>
            <span style="flex: 0 0 240px; font-size: 18px; font-weight: 600">{r.name} engineer</span>
            <span class="muted" style="flex: 1 1 360px; font-size: 15px">{r.stages.map((s) => s.name).join(' → ')}</span>
            <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8A94A6" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-band { position: relative; overflow: hidden; }
  .hero { position: relative; z-index: 1; pointer-events: none; padding-top: 72px; padding-bottom: 80px; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; align-items: center; }
  .hero > * { pointer-events: auto; }
  .zoom-hold { background: var(--bg); box-shadow: 0 0 0 24px var(--bg); }
  .hero-text .lead { margin: 22px 0 0; max-width: 520px; font-size: 19px; }
  .hero-ctas { display: flex; gap: 12px; margin-top: 32px; flex-wrap: wrap; }
  .hero-ctas .btn { min-height: 48px; padding: 0 24px; font-size: 16px; }
  .block { padding-bottom: 80px; }
  .two-col { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(480px, 100%), 1fr)); column-gap: 48px; margin-top: 8px; }
  .band { padding: 40px 0 72px; }
  .course-grid { margin-top: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(480px, 100%), 1fr)); gap: 40px 48px; }
  .course-card { display: flex; gap: 22px; align-items: flex-start; color: var(--text); text-decoration: none; }
  .course-card:hover { text-decoration: none; }
  .course-card:hover .course-name { text-decoration: underline; text-decoration-color: var(--line3); text-underline-offset: 4px; }
  .course-name { display: block; width: max-content; max-width: 100%; font-size: 19px; font-weight: 600; letter-spacing: -0.01em; }
  .course-blurb { display: block; margin-top: 4px; font-size: 15px; line-height: 1.55; }
  .course-meta { display: block; margin-top: 8px; font-size: 13px; }
  .three-col { margin-top: 36px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 40px; }
  .feat-title { margin: 14px 0 0; font-size: 18px; }
  .feat-body { margin: 8px 0 0; font-size: 16px; line-height: 1.6; }
  @media (max-width: 960px) { .hero { grid-template-columns: 1fr; } }
</style>
