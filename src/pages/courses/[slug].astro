---
import Base from '../../layouts/Base.astro';
import CourseArt from '../../components/CourseArt.astro';
import Eye from '../../components/Eye.astro';
import { courses, skillId } from '../../data/courses.js';
import { LEVELS } from '../../lib/eye.js';
import { glyph } from '../../lib/eye.js';
import { u, REPO } from '../../lib/url.js';

export function getStaticPaths() {
  return courses.map((c) => ({ params: { slug: c.slug }, props: { course: c } }));
}
const { course } = Astro.props as { course: any };
const open = course.status === 'open';
const allSkills: string[] = open ? course.units.flatMap((un: any) => un.skills) : [];
const firstReady = open ? course.units.flatMap((un: any) => un.items).find((i: any) => i.href) : null;
const kindIcon: Record<string, string> = {
  lesson: 'M3 5h6a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H3zM21 5h-6a3 3 0 0 0-3 3v12a2 2 0 0 1 2-2h7z',
  practice: 'M2 17h4V7h6v10h6V7h4',
  lab: 'M3 5h18v14H3zM7 10l3 2-3 2M12 15h5',
  quiz: 'M9 9a3 3 0 1 1 4 2.8c-.6.3-1 .9-1 1.6V15M12 18.5v.5',
};
---
<Base title={course.title} active="Courses">
  <div class="wrap" style="padding-top: 48px">
    <a class="quiet" href={u('/courses/')} style="font-size: 14px">← All courses</a>
    <div class="course-head">
      <CourseArt name={course.art} size={96} vt={`art-${course.slug}`} />
      <div>
        <p class="caps">Course · {open ? `${course.units.length} units` : 'being written'}</p>
        <h1 class="title" style={`margin-top: 8px; width: max-content; max-width: 100%; view-transition-name: title-${course.slug}`}>{course.title}</h1>
        <p class="lead" style="margin: 10px 0 0; max-width: 640px; font-size: 17px">{course.blurb}</p>
      </div>
    </div>

    {!open && (
      <section class="helpwanted">
        <p class="caps" style="color: var(--amber)">Help wanted</p>
        <h2 class="h3" style="margin-top: 8px">This course is planned but not written yet.</h2>
        <p class="muted" style="margin: 10px 0 0; max-width: 620px; line-height: 1.65">Lessons live as MDX files in the repo, one folder per course. If you know this topic, a single good lesson is a big contribution. Start with the digital logic course to see the format.</p>
        <div style="display: flex; gap: 12px; margin-top: 20px; flex-wrap: wrap">
          <a class="btn go" href={`${REPO}/blob/main/CONTRIBUTING.md`}>How to write a lesson</a>
          <a class="btn" href={u('/courses/digital-logic/')}>See an open course</a>
        </div>
      </section>
    )}

    {open && (
      <div class="course-body">
        <nav class="units" aria-label="Units">
          <p class="caps">Units</p>
          <ol>
            {course.units.map((un: any, i: number) => (
              <li><a href={`#unit-${i + 1}`}><span class="mono quiet">{String(i + 1).padStart(2, '0')}</span>{un.title}</a></li>
            ))}
          </ol>
        </nav>

        <div class="course-main">
          {firstReady && (
            <a class="upnext" href={u(firstReady.href)}>
              <span><span style="display: block; font-size: 13px; color: var(--amber)">Up next for you</span><span style="display: block; margin-top: 4px; font-size: 18px; font-weight: 600">{firstReady.title}</span></span>
              <span class="btn go sm">Start</span>
            </a>
          )}

          <section aria-labelledby="skills-title" style="margin-top: 40px">
            <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap">
              <h2 id="skills-title" class="h3">Your skills</h2>
              <p class="quiet" style="margin: 0; font-size: 14px"><span class="dots" style="font-size: 22px; color: var(--text)" data-skill-count={allSkills.map(skillId).join(',')}>0/{allSkills.length}</span> verified</p>
            </div>
            <div class="legend">
              {LEVELS.map((l) => { const g = glyph(l.id); return (
                <span><svg width="30" height="18" viewBox="0 0 40 24" aria-hidden="true"><path d={g.d} fill="none" stroke={g.color} stroke-width="1.4" stroke-linecap="round"></path></svg>{l.name}</span>
              ); })}
            </div>
            {course.units.map((un: any, i: number) => (
              <div class="skill-row">
                <span class="mono quiet" style="font-size: 12px; width: 120px; flex: none">UNIT {i + 1}</span>
                <div class="skill-eyes">
                  {un.skills.map((s: string) => <span title={s}><Eye skill={s} width={36} height={22} /></span>)}
                </div>
              </div>
            ))}
          </section>

          {course.units.map((un: any, i: number) => (
            <section class="unit" id={`unit-${i + 1}`} aria-labelledby={`unit-${i + 1}-title`}>
              <p class="caps">Unit {i + 1}</p>
              <h2 id={`unit-${i + 1}-title`} class="h2" style="margin-top: 6px; font-size: 24px">{un.title}</h2>
              <ul class="items">
                {un.items.map((it: any) => (
                  <li>
                    {it.href ? (
                      <a class="item" href={u(it.href)}>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#62D6A2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={kindIcon[it.kind]}></path></svg>
                        <span style="flex: 1 1 auto"><span style="display: block; font-size: 16px; font-weight: 500">{it.title}</span><span class="quiet" style="display: block; font-size: 13px; margin-top: 2px">{it.kind[0].toUpperCase() + it.kind.slice(1)}{it.minutes ? ` · ${it.minutes} min` : ''}</span></span>
                        <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8A94A6" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
                      </a>
                    ) : (
                      <span class="item planned">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3A4A5E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={kindIcon[it.kind]}></path></svg>
                        <span style="flex: 1 1 auto"><span style="display: block; font-size: 16px; color: var(--text2)">{it.title}</span><span class="quiet" style="display: block; font-size: 13px; margin-top: 2px">Planned · <a href={`${REPO}/blob/main/CONTRIBUTING.md`}>help write it</a></span></span>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    )}
  </div>
</Base>

<style>
  .course-head { display: flex; gap: 28px; align-items: center; margin-top: 24px; padding-bottom: 36px; border-bottom: 1px solid var(--line); }
  .helpwanted { margin-top: 40px; padding-left: 18px; border-left: 2px solid var(--amber); }
  .course-body { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 64px; margin-top: 40px; }
  .units { position: sticky; top: 24px; align-self: start; }
  .units ol { list-style: none; margin: 12px 0 0; padding: 0; }
  .units a { display: flex; gap: 12px; align-items: baseline; padding: 9px 0; border-bottom: 1px solid var(--line); color: var(--text2); font-size: 15px; }
  .units a:hover { color: var(--text); text-decoration: none; }
  .units .mono { font-size: 12px; }
  .upnext { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); color: var(--text); }
  .upnext:hover { text-decoration: none; }
  .legend { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 14px; font-size: 13px; color: var(--text2); }
  .legend span { display: inline-flex; align-items: center; gap: 8px; }
  .skill-row { display: flex; align-items: center; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .skill-row:first-of-type { margin-top: 16px; border-top: 1px solid var(--line); }
  .skill-eyes { display: flex; flex-wrap: wrap; gap: 14px; }
  .unit { margin-top: 56px; }
  .items { list-style: none; margin: 16px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .item { display: flex; align-items: center; gap: 16px; min-height: 64px; padding: 10px 0; border-bottom: 1px solid var(--line); color: var(--text); }
  a.item:hover { text-decoration: none; }
  a.item:hover .chev { transform: translateX(3px); }
  @media (max-width: 860px) { .course-body { grid-template-columns: 1fr; } .units { position: static; } .course-head { flex-direction: column; align-items: flex-start; } }
</style>
