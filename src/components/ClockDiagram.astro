---
// A clock with its rising edges, falling edges and period marked.
---
<figure class="clockfig">
  <svg viewBox="0 0 640 150" role="img" aria-label="A clock signal. Rising edges are marked in amber, the period is the time from one rising edge to the next.">
    <g font-family="Geist Mono Variable, Geist Mono, monospace" font-size="12">
      <path d="M80 0V96M240 0V96M400 0V96M560 0V96" stroke="#F2B35A" stroke-width="1" stroke-dasharray="3 4" opacity=".7"></path>
      <path class="reveal" pathLength="1" d="M0 84H80V24H160V84H240V24H320V84H400V24H480V84H560V24H640" fill="none" stroke="#E7EAF0" stroke-width="2"></path>
      <path d="M74 36l6-10 6 10" fill="none" stroke="#F2B35A" stroke-width="2" stroke-linejoin="round"></path>
      <text x="80" y="14" text-anchor="middle" fill="#F2B35A">rising edge</text>
      <path d="M154 72l6 10 6-10" fill="none" stroke="#8A94A6" stroke-width="2" stroke-linejoin="round"></path>
      <text x="160" y="108" text-anchor="middle" fill="#8A94A6">falling edge</text>
      <path d="M240 128H400M240 122V134M400 122V134" stroke="#9DB8FF" stroke-width="1.5"></path>
      <text x="320" y="146" text-anchor="middle" fill="#9DB8FF">one period, T</text>
    </g>
  </svg>
</figure>
<style>
  .clockfig { margin: 28px 0; }
  .clockfig svg { width: 100%; height: auto; }
</style>
