---
// One multiple-choice check. A right answer nudges the skill to "Simulated".
import { skillId } from '../data/courses.js';
interface Props { question: string; options: string[]; answer: number; right: string; wrong: string; skill: string }
const { question, options, answer, right, wrong, skill } = Astro.props;
const id = `q-${Math.random().toString(36).slice(2, 8)}`;
---
<section class="quiz" data-quiz data-answer={answer} data-skill={skillId(skill)} aria-labelledby={`${id}-t`}>
  <h2 id={`${id}-t`} class="h3">Check your understanding</h2>
  <fieldset>
    <legend>{question}</legend>
    {options.map((o, i) => (
      <label class="opt">
        <input type="radio" name={id} value={i} />
        <span>{o}</span>
      </label>
    ))}
  </fieldset>
  <div class="quiz-foot">
    <p class="fb right" data-right hidden role="status">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="tick" pathLength="1" d="M4 12.5l5 5L20 6.5"></path></svg>
      {right}
    </p>
    <p class="fb wrong" data-wrong hidden role="status">{wrong}</p>
    <button type="button" class="btn go" data-check>Check</button>
  </div>
</section>

<style>
  .quiz { margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--line); }
  fieldset { margin: 14px 0 0; padding: 0; border: 0; }
  legend { padding: 0; font-size: 17px; line-height: 1.6; color: var(--body); }
  .opt { display: flex; align-items: center; gap: 14px; min-height: 50px; padding: 0 2px; border-bottom: 1px solid var(--line); font-size: 16px; cursor: pointer; }
  .opt:first-of-type { margin-top: 14px; border-top: 1px solid var(--line); }
  .opt input { width: 18px; height: 18px; margin: 0; accent-color: var(--accent); }
  .opt.is-right span { color: var(--link); }
  .opt.is-wrong span { color: var(--red); text-decoration: line-through; text-decoration-color: rgba(240,105,127,.5); }
  .quiz-foot { display: flex; align-items: center; gap: 16px; margin-top: 18px; flex-wrap: wrap; }
  .fb { margin: 0; flex: 1 1 320px; display: inline-flex; align-items: center; gap: 8px; font-size: 16px; }
  .fb.right { color: var(--link); }
  .fb.wrong { color: var(--red); }
  .tick { stroke-dasharray: 1; animation: edgeDraw var(--slow) var(--ease) both; }
</style>

<script>
  import { raise } from '../scripts/progress.js';
  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((q) => {
    const answer = Number(q.dataset.answer);
    const btn = q.querySelector<HTMLButtonElement>('[data-check]')!;
    const rightEl = q.querySelector<HTMLElement>('[data-right]')!;
    const wrongEl = q.querySelector<HTMLElement>('[data-wrong]')!;
    const opts = [...q.querySelectorAll<HTMLLabelElement>('.opt')];
    const wrongText = wrongEl.textContent;
    q.addEventListener('change', () => { rightEl.hidden = true; wrongEl.hidden = true; opts.forEach((o) => o.classList.remove('is-right', 'is-wrong')); });
    btn.addEventListener('click', () => {
      const picked = q.querySelector<HTMLInputElement>('input:checked');
      if (!picked) { wrongEl.textContent = 'Pick an answer first.'; wrongEl.hidden = false; return; }
      wrongEl.textContent = wrongText;
      const i = Number(picked.value);
      opts[i].classList.add(i === answer ? 'is-right' : 'is-wrong');
      rightEl.hidden = i !== answer;
      wrongEl.hidden = i === answer;
      if (i === answer && q.dataset.skill) raise(q.dataset.skill, 1);
    });
  });
</script>
