---
// Flip two inputs, watch five gates answer. The truth table row lights up.
const gates = [
  { name: 'AND', expr: 'a & b' },
  { name: 'OR', expr: 'a | b' },
  { name: 'XOR', expr: 'a ^ b' },
  { name: 'NAND', expr: '~(a & b)' },
  { name: 'NOT a', expr: '~a' },
];
---
<section class="gp" data-gateplay aria-label="Try the gates">
  <div class="inputs">
    <p class="caps">Inputs · click to flip</p>
    <button type="button" class="bit" data-in="a" aria-pressed="false"><span class="mono">a</span><span class="v dots">0</span></button>
    <button type="button" class="bit" data-in="b" aria-pressed="false"><span class="mono">b</span><span class="v dots">0</span></button>
  </div>
  <div class="outs">
    <p class="caps">Outputs</p>
    {gates.map((g) => (
      <div class="out" data-gate={g.name}>
        <span class="led" aria-hidden="true"></span>
        <span class="gname">{g.name}</span>
        <span class="mono quiet expr">{g.expr}</span>
        <span class="v dots" data-v>0</span>
      </div>
    ))}
  </div>
  <table class="tt" aria-label="Truth table">
    <thead><tr><th>a</th><th>b</th>{gates.map((g) => <th>{g.name}</th>)}</tr></thead>
    <tbody>
      {[[0, 0], [0, 1], [1, 0], [1, 1]].map(([a, b]) => (
        <tr data-row={`${a}${b}`}>
          <td>{a}</td><td>{b}</td>
          <td>{a & b}</td><td>{a | b}</td><td>{a ^ b}</td><td>{(a & b) ^ 1}</td><td>{a ^ 1}</td>
        </tr>
      ))}
    </tbody>
  </table>
</section>

<style>
  .gp { margin: 32px 0; display: grid; grid-template-columns: 200px 1fr; gap: 8px 40px; padding: 20px 0; border-top: 1px solid var(--line2); border-bottom: 1px solid var(--line2); }
  .bit { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 52px; margin-top: 10px; padding: 0 14px; border: 1px solid var(--line2); border-radius: 8px; background: none; cursor: pointer; font-size: 16px; }
  .bit:hover { border-color: var(--line3); }
  .bit[aria-pressed="true"] { border-color: var(--accent); }
  .bit .v { font-size: 24px; }
  .bit[aria-pressed="true"] .v { color: var(--link); }
  .out { display: grid; grid-template-columns: 14px 64px 1fr auto; align-items: center; gap: 12px; min-height: 40px; border-bottom: 1px solid var(--line); }
  .out:first-of-type { margin-top: 10px; border-top: 1px solid var(--line); }
  .led { width: 10px; height: 10px; border-radius: 50%; background: #273242; transition: background var(--base) var(--ease), box-shadow var(--base) var(--ease); }
  .out.on .led { background: var(--accent); box-shadow: 0 0 10px rgba(63,191,134,.6); }
  .gname { font-weight: 600; font-size: 15px; }
  .expr { font-size: 13px; }
  .out .v { font-size: 20px; color: var(--text3); }
  .out.on .v { color: var(--link); }
  .tt { grid-column: 1 / -1; margin-top: 18px; border-collapse: collapse; font-family: var(--mono); font-size: 13px; width: 100%; }
  .tt th { text-align: left; font-weight: 500; color: var(--text3); padding: 6px 8px; border-bottom: 1px solid var(--line2); }
  .tt td { padding: 6px 8px; border-bottom: 1px solid var(--line); color: var(--text2); }
  .tt tr.cur td { color: var(--text); box-shadow: inset 0 -1px 0 var(--accent); }
  @media (max-width: 640px) { .gp { grid-template-columns: 1fr; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gateplay]').forEach((root) => {
    const st: Record<string, number> = { a: 0, b: 0 };
    const F: Record<string, (a: number, b: number) => number> = {
      AND: (a, b) => a & b, OR: (a, b) => a | b, XOR: (a, b) => a ^ b, NAND: (a, b) => (a & b) ^ 1, 'NOT a': (a) => a ^ 1,
    };
    const render = () => {
      root.querySelectorAll<HTMLButtonElement>('[data-in]').forEach((b) => {
        const v = st[b.dataset.in!];
        b.setAttribute('aria-pressed', String(!!v));
        b.querySelector('.v')!.textContent = String(v);
      });
      root.querySelectorAll<HTMLElement>('[data-gate]').forEach((g) => {
        const v = F[g.dataset.gate!](st.a, st.b);
        g.classList.toggle('on', !!v);
        g.querySelector('[data-v]')!.textContent = String(v);
      });
      root.querySelectorAll<HTMLElement>('[data-row]').forEach((r) => r.classList.toggle('cur', r.dataset.row === `${st.a}${st.b}`));
    };
    root.querySelectorAll<HTMLButtonElement>('[data-in]').forEach((b) => b.addEventListener('click', () => { st[b.dataset.in!] ^= 1; render(); }));
    render();
  });
</script>
